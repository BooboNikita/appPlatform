<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.app.app.mapper.DynamicConfigHistoryMapper">

    <resultMap id="BaseResultMap" type="com.app.app.entity.DynamicConfigHistory">
        <id column="id" property="id"/>
        <result column="config_id" property="configId"/>
        <result column="version_range" property="versionRange"/>
        <result column="file_path" property="fileUrl"/>
        <result column="env" property="env"/>
        <result column="remark" property="remark"/>
        <result column="operator" property="operator"/>
        <result column="operation" property="operationType"/>
        <result column="created_at" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, config_id, version_range, file_path, env, remark, operator, operation, created_at
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO dynamic_config_history (config_id, version_range, file_path, env, remark, operator, operation, created_at)
        VALUES (#{configId}, #{versionRange}, #{fileUrl}, #{env}, #{remark}, #{operator}, #{operationType}, #{createTime})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM dynamic_config_history
        WHERE id = #{id}
    </select>

    <select id="selectByConfigId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM dynamic_config_history
        WHERE config_id = #{configId}
        ORDER BY created_at DESC
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM dynamic_config_history
        ORDER BY created_at DESC
    </select>

    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM dynamic_config_history
        WHERE 1=1
        <if test="env != null and env != ''">
            AND env = #{env}
        </if>
        <if test="versionRange != null and versionRange != ''">
            AND version_range LIKE CONCAT('%', #{versionRange}, '%')
        </if>
        ORDER BY created_at DESC
    </select>

</mapper>
